From 83608fa00f912710ab0cc12e6665fa8b3ec383ce Mon Sep 17 00:00:00 2001
From: bits <bigbits@hackx.cc>
Date: Mon, 2 Nov 2026 15:04:30 +0800
Subject: [PATCH 06/13] ASoC: qcom: enable A081 microphone and codec paths

Split the existing A081 downstream source by subsystem.
The final file contents match the archived device-baseline sources;
this commit does not claim independent intermediate hardware acceptance.
---
 sound/soc/codecs/wcd938x.c | 40 +++++++++++++++++++++++++++-----------
 sound/soc/qcom/sdw.c       | 11 +++++++++++
 sound/soc/qcom/sm8250.c    | 35 ++++++++++++++++++++++++++++++++-
 3 files changed, 74 insertions(+), 12 deletions(-)

diff --git a/sound/soc/codecs/wcd938x.c b/sound/soc/codecs/wcd938x.c
index 9a9ea37ecab..49cd91bdd3f 100644
--- a/sound/soc/codecs/wcd938x.c
+++ b/sound/soc/codecs/wcd938x.c
@@ -21,6 +21,7 @@
 #include <sound/soc-dapm.h>
 #include <linux/mux/consumer.h>
 #include <linux/regulator/consumer.h>
+#include <linux/workqueue.h>
 
 #include "wcd-clsh-v2.h"
 #include "wcd-common.h"
@@ -145,6 +146,7 @@ static u8 tx_mode_bit[] = {
 };
 
 struct wcd938x_priv {
+	struct work_struct component_work;
 	struct sdw_slave *tx_sdw_dev;
 	struct wcd938x_sdw_priv *sdw_priv[NUM_CODEC_DAIS];
 	struct device *txdev;
@@ -3325,6 +3327,19 @@ static struct snd_soc_dai_driver wcd938x_dais[] = {
 	},
 };
 
+static void wcd938x_register_component(struct work_struct *work)
+{
+	struct wcd938x_priv *wcd938x = container_of(work, struct wcd938x_priv,
+						 component_work);
+	struct device *dev = wcd938x->common.dev;
+	int ret;
+
+	ret = snd_soc_register_component(dev, &soc_codec_dev_wcd938x,
+					 wcd938x_dais, ARRAY_SIZE(wcd938x_dais));
+	if (ret)
+		dev_err(dev, "Codec registration failed: %d\n", ret);
+}
+
 static int wcd938x_bind(struct device *dev)
 {
 	struct wcd938x_priv *wcd938x = dev_get_drvdata(dev);
@@ -3397,13 +3412,12 @@ static int wcd938x_bind(struct device *dev)
 
 	wcd938x_set_micbias_data(dev, wcd938x);
 
-	ret = snd_soc_register_component(dev, &soc_codec_dev_wcd938x,
-					 wcd938x_dais, ARRAY_SIZE(wcd938x_dais));
-	if (ret) {
-		dev_err(dev, "%s: Codec registration failed\n",
-				__func__);
-		goto err_remove_rx_link;
-	}
+	/*
+	 * The last SoundWire slave can call us from its probe. ASoC may
+	 * immediately probe the codec and wait for SoundWire initialization,
+	 * which cannot finish until that slave probe has returned.
+	 */
+	schedule_work(&wcd938x->component_work);
 
 	return 0;
 
@@ -3427,6 +3441,7 @@ static void wcd938x_unbind(struct device *dev)
 {
 	struct wcd938x_priv *wcd938x = dev_get_drvdata(dev);
 
+	cancel_work_sync(&wcd938x->component_work);
 	snd_soc_unregister_component(dev);
 	device_link_remove(dev, wcd938x->txdev);
 	device_link_remove(dev, wcd938x->rxdev);
@@ -3485,6 +3500,7 @@ static int wcd938x_probe(struct platform_device *pdev)
 	mutex_init(&wcd938x->micb_lock);
 	wcd938x->common.dev = dev;
 	wcd938x->common.max_bias = 4;
+	INIT_WORK(&wcd938x->component_work, wcd938x_register_component);
 
 	ret = wcd938x_populate_dt_data(wcd938x, dev);
 	if (ret)
@@ -3496,15 +3512,17 @@ static int wcd938x_probe(struct platform_device *pdev)
 
 	wcd938x_reset(wcd938x);
 
-	ret = component_master_add_with_match(dev, &wcd938x_comp_ops, match);
-	if (ret)
-		return ret;
-
 	pm_runtime_set_autosuspend_delay(dev, 1000);
 	pm_runtime_use_autosuspend(dev);
 	pm_runtime_mark_last_busy(dev);
 	pm_runtime_set_active(dev);
 	pm_runtime_enable(dev);
+	ret = component_master_add_with_match(dev, &wcd938x_comp_ops, match);
+	if (ret) {
+		pm_runtime_disable(dev);
+		pm_runtime_set_suspended(dev);
+		return ret;
+	}
 	pm_runtime_idle(dev);
 
 	return 0;
diff --git a/sound/soc/qcom/sdw.c b/sound/soc/qcom/sdw.c
index 6576b47a4c8..f5f3e391cfc 100644
--- a/sound/soc/qcom/sdw.c
+++ b/sound/soc/qcom/sdw.c
@@ -69,11 +69,22 @@ int qcom_snd_sdw_startup(struct snd_pcm_substream *substream)
 	struct sdw_stream_runtime *sruntime;
 	struct snd_soc_dai *codec_dai;
 	u32 rx_ch_cnt = 0, tx_ch_cnt = 0;
+	bool has_sdw_codec = false;
 	int ret, i, j;
 
 	if (!qcom_snd_is_sdw_dai(cpu_dai->id))
 		return 0;
 
+	/* A CDC DMA port can also capture directly from LPASS DMICs. */
+	for_each_rtd_codec_dais(rtd, i, codec_dai) {
+		if (codec_dai->driver->ops->set_stream) {
+			has_sdw_codec = true;
+			break;
+		}
+	}
+	if (!has_sdw_codec)
+		return 0;
+
 	sruntime = sdw_alloc_stream(cpu_dai->name, SDW_STREAM_PCM);
 	if (!sruntime)
 		return -ENOMEM;
diff --git a/sound/soc/qcom/sm8250.c b/sound/soc/qcom/sm8250.c
index 76dc3a3f4a3..1c171458037 100644
--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -78,8 +78,22 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
+	int ret, i;
 
 	switch (cpu_dai->id) {
+	case SENARY_MI2S_RX:
+		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
+		ret = snd_soc_dai_set_fmt(cpu_dai, fmt);
+		if (ret)
+			return ret;
+		for_each_rtd_codec_dais(rtd, i, codec_dai) {
+			ret = snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
+			if (ret)
+				return ret;
+		}
+		return snd_soc_dai_set_sysclk(cpu_dai,
+				Q6AFE_LPASS_CLK_ID_SEN_MI2S_IBIT,
+				MI2S_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
 	case PRIMARY_MI2S_RX:
 		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
 		snd_soc_dai_set_sysclk(cpu_dai,
@@ -135,6 +149,25 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 	return qcom_snd_sdw_startup(substream);
 }
 
+static void sm8250_snd_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	int ret;
+
+	if (cpu_dai->id == SENARY_MI2S_RX) {
+		ret = snd_soc_dai_set_sysclk(cpu_dai,
+				Q6AFE_LPASS_CLK_ID_SEN_MI2S_IBIT, 0,
+				SNDRV_PCM_STREAM_PLAYBACK);
+		if (ret)
+			dev_err(rtd->dev, "Failed to disable senary MI2S clock: %d\n",
+				ret);
+		return;
+	}
+
+	qcom_snd_sdw_shutdown(substream);
+}
+
 static int sm8250_snd_prepare(struct snd_pcm_substream *substream)
 {
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
@@ -155,7 +188,7 @@ static int sm8250_snd_hw_free(struct snd_pcm_substream *substream)
 
 static const struct snd_soc_ops sm8250_be_ops = {
 	.startup = sm8250_snd_startup,
-	.shutdown = qcom_snd_sdw_shutdown,
+	.shutdown = sm8250_snd_shutdown,
 	.hw_free = sm8250_snd_hw_free,
 	.prepare = sm8250_snd_prepare,
 };
