+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _QCOM_FG4_CORE_H
+#define _QCOM_FG4_CORE_H
+
+#include <linux/mutex.h>
+#include <linux/types.h>
+
+struct regmap;
+
+#define FG4_SRAM_SIZE 972
+
+struct qcom_fg4 {
+	struct regmap *map;
+	/* Serializes DMA acquisition, data access and pending cleanup. */
+	struct mutex lock;
+	u16 base;
+	unsigned int major;
+	/* Keep this snapshot until every cleanup transaction has succeeded. */
+	bool restore_pending;
+	/* A failed clear-log write may have reached the PMIC. */
+	bool dma_clear_pending;
+	u8 saved_dma, saved_arb, saved_mux;
+	int cleanup_error;
+};
+
+int qcom_fg4_check_hardware(struct qcom_fg4 *fg);
+int qcom_fg4_release(struct qcom_fg4 *fg);
+int qcom_fg4_sram_read(struct qcom_fg4 *fg, unsigned int offset,
+		       void *data, size_t len);
+int qcom_fg4_sram_write(struct qcom_fg4 *fg, unsigned int offset,
+			const void *data, size_t len);
+int qcom_fg4_battery_id(struct qcom_fg4 *fg, unsigned int *ohms);
+int qcom_fg4_present(struct qcom_fg4 *fg, int *value);
+int qcom_fg4_voltage(struct qcom_fg4 *fg, int *value);
+int qcom_fg4_current(struct qcom_fg4 *fg, int *value);
+int qcom_fg4_capacity(struct qcom_fg4 *fg, int *value);
+int qcom_fg4_temperature(struct qcom_fg4 *fg, int *millicelsius);
+
+#endif
diff --git a/drivers/power/supply/qcom-fg4-profile.c b/drivers/power/supply/qcom-fg4-profile.c
new file mode 100644
index 00000000000..992b954e760
--- /dev/null
+++ b/drivers/power/supply/qcom-fg4-profile.c
@@ -0,0 +1,264 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2018-2020 The Linux Foundation. All rights reserved.
+ * Copyright (c) 2022 Qualcomm Innovation Center, Inc. All rights reserved.
+ *
+ * PM8150B profile initialization, derived from qpnp-fg-gen4.c and fg-util.c.
+ * Transport and failure handling are local. See references/power for provenance.
+ */
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/math64.h>
+#include <linux/regmap.h>
+#include <linux/unaligned.h>
+
+#include "qcom-fg4-profile.h"
+
+#define FG4_PROFILE_BYTE		130
+#define FG4_PROFILE_ID_SIZE	24
+#define FG4_INTEGRITY_BYTE	598
+#define FG4_SYS_CONFIG_BYTE	120
+#define FG4_FIRST_CURRENT_BYTE	942
+#define FG4_RESTART_REG		0x048
+#define FG4_RESTART_GO		BIT(0)
+#define FG4_SIDE_LOAD		BIT(0)
+
+int qcom_fg4_profile_validate(const struct qcom_fg4_profile *profile)
+{
+	if (!profile || !profile->id_ohms || profile->id_tolerance_percent > 100 ||
+	    !profile->nominal_mah || profile->nominal_mah > 32767 ||
+	    profile->full_voltage_uv < 2000000 || profile->full_voltage_uv > 5500000)
+		return -EINVAL;
+	/* NOM_CAP word 271 is within the fixed 416-byte profile. */
+	if (get_unaligned_le16(profile->data + 412) != profile->nominal_mah)
+		return -EINVAL;
+	if (profile->therm_pullup_kohms != 30 && profile->therm_pullup_kohms != 100 &&
+	    profile->therm_pullup_kohms != 400)
+		return -EINVAL;
+	return 0;
+}
+
+static int fg4_sram_update(struct qcom_fg4 *fg, unsigned int offset, u8 mask, u8 value)
+{
+	u8 old;
+	int ret;
+
+	ret = qcom_fg4_sram_read(fg, offset, &old, 1);
+	if (ret)
+		return ret;
+	old = (old & ~mask) | (value & mask);
+	return qcom_fg4_sram_write(fg, offset, &old, 1);
+}
+
+int qcom_fg4_profile_abort(struct qcom_fg4 *fg, struct qcom_fg4_profile_state *state)
+{
+	u8 invalid = 0;
+	int ret, first;
+
+	state->valid = false;
+	mutex_lock(&fg->lock);
+	first = qcom_fg4_release(fg);
+	mutex_unlock(&fg->lock);
+	if (state->restart_pending) {
+		ret = regmap_update_bits(fg->map, fg->base + FG4_RESTART_REG, FG4_RESTART_GO, 0);
+		if (!ret)
+			state->restart_pending = false;
+		else if (!first)
+			first = ret;
+	}
+	if (state->dirty) {
+		ret = qcom_fg4_sram_write(fg, FG4_INTEGRITY_BYTE, &invalid, 1);
+		if (!ret)
+			state->dirty = false;
+		else if (!first)
+			first = ret;
+	}
+	if (state->side_pending) {
+		ret = fg4_sram_update(fg, FG4_SYS_CONFIG_BYTE, FG4_SIDE_LOAD, state->saved_side);
+		if (!ret)
+			state->side_pending = false;
+		else if (!first)
+			first = ret;
+	}
+	state->cleanup_error = first;
+	return first;
+}
+
+static int fg4_profile_matches(struct qcom_fg4 *fg, const struct qcom_fg4_profile *profile,
+			       bool *matches)
+{
+	static const u8 valid_integrity[] = { 0x09, 0x03, 0x07, 0x0d, 0x13, 0x17, 0x1d };
+	u8 integrity, identity[FG4_PROFILE_ID_SIZE], nominal[2];
+	int ret, i;
+
+	*matches = false;
+	ret = qcom_fg4_sram_read(fg, FG4_INTEGRITY_BYTE, &integrity, 1);
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(valid_integrity); i++)
+		if (integrity == valid_integrity[i])
+			break;
+	if (i == ARRAY_SIZE(valid_integrity))
+		return 0;
+	ret = qcom_fg4_sram_read(fg, FG4_PROFILE_BYTE, identity, sizeof(identity));
+	if (ret)
+		return ret;
+	ret = qcom_fg4_sram_read(fg, 271 * 2, nominal, sizeof(nominal));
+	if (ret)
+		return ret;
+	/* Other profile fields can change during normal gauge operation. */
+	*matches = !memcmp(identity, profile->data, sizeof(identity)) &&
+		   get_unaligned_le16(nominal) == profile->nominal_mah;
+	return 0;
+}
+
+static int fg4_profile_parameters(struct qcom_fg4 *fg, const struct qcom_fg4_profile *profile)
+{
+	u8 coefficients[10], raw[2];
+	unsigned int pullup;
+	int ret, i;
+
+	for (i = 0; i < ARRAY_SIZE(profile->therm_coeffs); i++)
+		put_unaligned_le16(profile->therm_coeffs[i], coefficients + 2 * i);
+	ret = qcom_fg4_sram_write(fg, 4 * 2, coefficients, sizeof(coefficients));
+	if (ret)
+		return ret;
+	ret = qcom_fg4_sram_write(fg, 7, &profile->therm_center, 1);
+	if (ret)
+		return ret;
+	pullup = profile->therm_pullup_kohms == 30 ? 1 :
+		 profile->therm_pullup_kohms == 100 ? 2 : 3;
+	ret = regmap_update_bits(fg->map, fg->base + 0x281, 3, pullup);
+	if (ret)
+		return ret;
+	/* FG full-voltage threshold; this does not program a charger limit. */
+	put_unaligned_le16(div_u64((u64)profile->full_voltage_uv * 1000, 244141), raw);
+	ret = qcom_fg4_sram_write(fg, 23 * 2, raw, sizeof(raw));
+	if (ret)
+		return ret;
+	if (fg->major == 1)
+		return fg4_sram_update(fg, 241 * 2, BIT(1), 0);
+	if (fg->major != 2)
+		return 0;
+	/* The V2 Rslow scale workaround uses words which hold V1 learned capacity. */
+	put_unaligned_le16(0x4000, raw);
+	ret = qcom_fg4_sram_write(fg, 285 * 2, raw, sizeof(raw));
+	if (ret)
+		return ret;
+	return qcom_fg4_sram_write(fg, 281 * 2, raw, sizeof(raw));
+}
+
+static int fg4_restart(struct qcom_fg4 *fg, struct qcom_fg4_profile_state *state,
+		       const struct qcom_fg4_restart_ops *restart)
+{
+	int ret, cleanup;
+
+	restart->prepare(restart->context);
+	state->restart_pending = true;
+	ret = regmap_update_bits(fg->map, fg->base + FG4_RESTART_REG,
+				 FG4_RESTART_GO, FG4_RESTART_GO);
+	if (!ret)
+		ret = restart->wait(restart->context, 1000);
+	/* Preserve a timeout even when clearing RESTART_GO succeeds. */
+	cleanup = regmap_update_bits(fg->map, fg->base + FG4_RESTART_REG, FG4_RESTART_GO, 0);
+	if (!cleanup)
+		state->restart_pending = false;
+	return ret ?: cleanup;
+}
+
+int qcom_fg4_profile_start(struct qcom_fg4 *fg, const struct qcom_fg4_profile *profile,
+			   struct qcom_fg4_profile_state *state,
+			   const struct qcom_fg4_restart_ops *restart)
+{
+	unsigned int value, difference;
+	u8 sys_config, integrity = 0, raw[2] = { 0, 0 };
+	bool matches;
+	int ret, present;
+
+	ret = qcom_fg4_profile_validate(profile);
+	if (ret || !restart || !restart->prepare || !restart->wait)
+		return ret ?: -EINVAL;
+	ret = qcom_fg4_profile_abort(fg, state);
+	if (ret)
+		return ret;
+	state->loaded = false;
+	ret = qcom_fg4_present(fg, &present);
+	if (ret || !present)
+		return ret ?: -ENODEV;
+	ret = qcom_fg4_battery_id(fg, &value);
+	if (ret)
+		return ret;
+	state->measured_id_ohms = value;
+	difference = value > profile->id_ohms ? value - profile->id_ohms : profile->id_ohms - value;
+	if ((u64)difference * 100 > (u64)profile->id_ohms * profile->id_tolerance_percent)
+		return -ENODEV;
+	ret = regmap_read(fg->map, fg->base + FG4_RESTART_REG, &value);
+	if (ret || (value & FG4_RESTART_GO))
+		return ret ?: -EBUSY;
+	ret = regmap_read(fg->map, fg->base + 0x046, &value);
+	if (ret || !(value & BIT(7)))
+		return ret ?: -ENODATA;
+	ret = qcom_fg4_sram_read(fg, FG4_SYS_CONFIG_BYTE, &sys_config, 1);
+	if (ret || (sys_config & FG4_SIDE_LOAD))
+		return ret ?: -EBUSY;
+	state->saved_side = sys_config & FG4_SIDE_LOAD;
+	ret = fg4_profile_matches(fg, profile, &matches);
+	if (ret)
+		return ret;
+	/* Any failed profile/parameter write must invalidate the integrity marker. */
+	state->dirty = true;
+	if (!matches) {
+		ret = qcom_fg4_sram_write(fg, FG4_INTEGRITY_BYTE, &integrity, 1);
+		if (ret)
+			goto fail;
+		ret = qcom_fg4_sram_write(fg, FG4_PROFILE_BYTE, profile->data, FG4_PROFILE_SIZE);
+		if (ret)
+			goto fail;
+		state->side_pending = true;
+		ret = fg4_sram_update(fg, FG4_SYS_CONFIG_BYTE, FG4_SIDE_LOAD, FG4_SIDE_LOAD);
+		if (ret)
+			goto fail;
+		ret = qcom_fg4_sram_write(fg, FG4_FIRST_CURRENT_BYTE, raw, sizeof(raw));
+		if (ret)
+			goto fail;
+		integrity = 0x09;
+		ret = qcom_fg4_sram_write(fg, FG4_INTEGRITY_BYTE, &integrity, 1);
+		if (ret)
+			goto fail;
+		ret = fg4_restart(fg, state, restart);
+		if (ret)
+			goto fail;
+		ret = fg4_sram_update(fg, FG4_SYS_CONFIG_BYTE, FG4_SIDE_LOAD, state->saved_side);
+		if (ret)
+			goto fail;
+		state->side_pending = false;
+		if (fg->major == 1)
+			msleep(1000);
+		put_unaligned_le16(profile->nominal_mah, raw);
+		ret = qcom_fg4_sram_write(fg, (fg->major == 1 ? 285 : 287) * 2, raw, sizeof(raw));
+		if (ret)
+			goto fail;
+		state->loaded = true;
+	}
+	ret = fg4_profile_parameters(fg, profile);
+	if (ret)
+		goto fail;
+	ret = regmap_read(fg->map, fg->base + 0x010, &value);
+	if (ret || !(value & BIT(1))) {
+		ret = ret ?: -ENODATA;
+		goto fail;
+	}
+	ret = qcom_fg4_present(fg, &present);
+	if (ret || !present) {
+		ret = ret ?: -ENODEV;
+		goto fail;
+	}
+	state->dirty = false;
+	state->valid = true;
+	return 0;
+fail:
+	qcom_fg4_profile_abort(fg, state);
+	return ret;
+}
diff --git a/drivers/power/supply/qcom-fg4-profile.h b/drivers/power/supply/qcom-fg4-profile.h
new file mode 100644
index 00000000000..8701b4d026a
--- /dev/null
+++ b/drivers/power/supply/qcom-fg4-profile.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _QCOM_FG4_PROFILE_H
+#define _QCOM_FG4_PROFILE_H
+
+#include "qcom-fg4-core.h"
+
+#define FG4_PROFILE_SIZE 416
+
+struct qcom_fg4_profile {
+	u8 data[FG4_PROFILE_SIZE];
+	u32 id_ohms;
+	u32 id_tolerance_percent;
+	/* Gauge algorithm nominal from the payload, not the battery design rating. */
+	u32 nominal_mah;
+	u32 full_voltage_uv;
+	u16 therm_coeffs[5];
+	u8 therm_center;
+	u32 therm_pullup_kohms;
+};
+
+struct qcom_fg4_profile_state {
+	bool valid;
+	bool loaded;
+	bool dirty;
+	bool restart_pending;
+	bool side_pending;
+	u8 saved_side;
+	u32 measured_id_ohms;
+	int cleanup_error;
+};
+
+/* IRQ completion is provided by the platform driver, never by a stale level. */
+struct qcom_fg4_restart_ops {
+	void (*prepare)(void *context);
+	int (*wait)(void *context, unsigned int milliseconds);
+	void *context;
+};
+
+int qcom_fg4_profile_validate(const struct qcom_fg4_profile *profile);
+int qcom_fg4_profile_abort(struct qcom_fg4 *fg, struct qcom_fg4_profile_state *state);
+int qcom_fg4_profile_start(struct qcom_fg4 *fg, const struct qcom_fg4_profile *profile,
+			   struct qcom_fg4_profile_state *state,
+			   const struct qcom_fg4_restart_ops *restart);
+
+#endif
diff --git a/drivers/power/supply/qcom-fg4.c b/drivers/power/supply/qcom-fg4.c
new file mode 100644
index 00000000000..1291f87a79f
--- /dev/null
+++ b/drivers/power/supply/qcom-fg4.c
@@ -0,0 +1,371 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* PM8150B FG GEN4 profile, telemetry and power_supply integration. */
+#include <linux/completion.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm.h>
+#include <linux/pm_wakeirq.h>
+#include <linux/power_supply.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+#include <soc/qcom/qcom-spmi-pmic.h>
+
+#include "qcom-fg4-profile.h"
+
+struct fg4_chip {
+	struct qcom_fg4 core;
+	struct qcom_fg4_profile profile;
+	struct qcom_fg4_profile_state profile_state;
+	struct completion soc_ready;
+	int irqs[5];
+	struct device *dev;
+	struct power_supply *psy;
+	struct power_supply_desc desc;
+	/* Keeps property reads outside suspend and teardown cleanup. */
+	struct mutex access_lock;
+	bool suspended;
+};
+
+static enum power_supply_property fg4_properties[] = {
+	POWER_SUPPLY_PROP_MANUFACTURER,
+	POWER_SUPPLY_PROP_MODEL_NAME,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_TEMP,
+};
+
+static int fg4_get_measurement(struct fg4_chip *chip, enum power_supply_property prop,
+			       union power_supply_propval *val)
+{
+	int present, temperature, ret;
+
+	/* A retained DMA request can stall the gauge algorithm between reads. */
+	if (chip->core.restore_pending || chip->core.dma_clear_pending) {
+		mutex_lock(&chip->core.lock);
+		ret = qcom_fg4_release(&chip->core);
+		mutex_unlock(&chip->core.lock);
+		if (ret)
+			return ret;
+	}
+	ret = qcom_fg4_present(&chip->core, &present);
+	if (ret)
+		return ret;
+	if (prop == POWER_SUPPLY_PROP_PRESENT) {
+		val->intval = present;
+		return 0;
+	}
+	if (!present)
+		return -ENODATA;
+	if ((prop == POWER_SUPPLY_PROP_CAPACITY || prop == POWER_SUPPLY_PROP_TEMP) &&
+	    !chip->profile_state.valid)
+		return -ENODATA;
+	switch (prop) {
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		return qcom_fg4_voltage(&chip->core, &val->intval);
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		return qcom_fg4_current(&chip->core, &val->intval);
+	case POWER_SUPPLY_PROP_CAPACITY:
+		return qcom_fg4_capacity(&chip->core, &val->intval);
+	case POWER_SUPPLY_PROP_TEMP:
+		ret = qcom_fg4_temperature(&chip->core, &temperature);
+		if (!ret)
+			val->intval = temperature / 100;
+		return ret;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int fg4_get_property(struct power_supply *psy, enum power_supply_property prop,
+			    union power_supply_propval *val)
+{
+	struct fg4_chip *chip = power_supply_get_drvdata(psy);
+	int ret;
+
+	if (prop == POWER_SUPPLY_PROP_MANUFACTURER) {
+		val->strval = "Qualcomm";
+		return 0;
+	}
+	if (prop == POWER_SUPPLY_PROP_MODEL_NAME) {
+		val->strval = "PM8150B FG GEN4";
+		return 0;
+	}
+	mutex_lock(&chip->access_lock);
+	if (chip->suspended)
+		ret = -EHOSTDOWN;
+	else
+		ret = fg4_get_measurement(chip, prop, val);
+	if (chip->core.cleanup_error)
+		dev_err_ratelimited(chip->dev, "DMA access cleanup pending: %d\n",
+				    chip->core.cleanup_error);
+	mutex_unlock(&chip->access_lock);
+	return ret;
+}
+
+static const struct power_supply_desc fg4_desc = {
+	.name = "pm8150b-battery",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = fg4_properties,
+	.num_properties = ARRAY_SIZE(fg4_properties),
+	.get_property = fg4_get_property,
+};
+
+static irqreturn_t fg4_changed(int irq, void *data)
+{
+	struct fg4_chip *chip = data;
+	struct power_supply *psy;
+
+	if (irq == chip->irqs[0])
+		complete(&chip->soc_ready);
+	if (irq == chip->irqs[2]) {
+		mutex_lock(&chip->access_lock);
+		chip->profile_state.valid = false;
+		mutex_unlock(&chip->access_lock);
+	}
+	psy = READ_ONCE(chip->psy);
+	if (psy)
+		power_supply_changed(psy);
+	return IRQ_HANDLED;
+}
+
+static void fg4_stop_notifications(void *data)
+{
+	struct fg4_chip *chip = data;
+	int i;
+
+	WRITE_ONCE(chip->psy, NULL);
+	for (i = 0; i < ARRAY_SIZE(chip->irqs); i++)
+		if (chip->irqs[i] > 0)
+			synchronize_irq(chip->irqs[i]);
+}
+
+static void fg4_prepare_restart(void *context)
+{
+	struct fg4_chip *chip = context;
+
+	synchronize_irq(chip->irqs[0]);
+	reinit_completion(&chip->soc_ready);
+}
+
+static int fg4_wait_restart(void *context, unsigned int milliseconds)
+{
+	struct fg4_chip *chip = context;
+
+	return wait_for_completion_timeout(&chip->soc_ready, msecs_to_jiffies(milliseconds)) ?
+		0 : -ETIMEDOUT;
+}
+
+static void fg4_cleanup(void *data)
+{
+	struct fg4_chip *chip = data;
+	int ret;
+
+	mutex_lock(&chip->access_lock);
+	ret = qcom_fg4_profile_abort(&chip->core, &chip->profile_state);
+	mutex_unlock(&chip->access_lock);
+	if (ret)
+		dev_err(chip->dev, "profile/DMA cleanup pending on removal: %d\n", ret);
+}
+
+static int fg4_parse_profile(struct fg4_chip *chip)
+{
+	struct qcom_fg4_profile *profile = &chip->profile;
+	struct fwnode_handle *battery;
+	u32 capacity, maximum_uv, value, coefficients[5];
+	int ret, i;
+
+	if (device_property_count_u8(chip->dev, "qcom,fg-profile-data") != FG4_PROFILE_SIZE)
+		return -EINVAL;
+	ret = device_property_read_u8_array(chip->dev, "qcom,fg-profile-data",
+					    profile->data, FG4_PROFILE_SIZE);
+	if (ret)
+		return ret;
+	ret = device_property_read_u32(chip->dev, "qcom,battery-id-ohms", &profile->id_ohms);
+	if (ret)
+		return ret;
+	ret = device_property_read_u32(chip->dev, "qcom,battery-id-tolerance-percent",
+				       &profile->id_tolerance_percent);
+	if (ret)
+		return ret;
+	ret = device_property_read_u32(chip->dev, "qcom,fg-full-voltage-microvolt",
+				       &profile->full_voltage_uv);
+	if (ret)
+		return ret;
+	ret = device_property_read_u32_array(chip->dev, "qcom,therm-coefficients", coefficients, 5);
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(coefficients); i++) {
+		if (coefficients[i] > U16_MAX)
+			return -EINVAL;
+		profile->therm_coeffs[i] = coefficients[i];
+	}
+	ret = device_property_read_u32(chip->dev, "qcom,therm-center-offset", &value);
+	if (ret || value > U8_MAX)
+		return ret ?: -EINVAL;
+	profile->therm_center = value;
+	ret = device_property_read_u32(chip->dev, "qcom,therm-pull-up-ohms", &value);
+	if (ret || value % 1000)
+		return ret ?: -EINVAL;
+	profile->therm_pullup_kohms = value / 1000;
+	battery = fwnode_find_reference(dev_fwnode(chip->dev), "monitored-battery", 0);
+	if (IS_ERR(battery))
+		return PTR_ERR(battery);
+	ret = fwnode_property_read_u32(battery, "charge-full-design-microamp-hours", &capacity);
+	if (!ret)
+		ret = fwnode_property_read_u32(battery, "voltage-max-design-microvolt",
+					       &maximum_uv);
+	fwnode_handle_put(battery);
+	if (ret)
+		return ret;
+	if (!capacity || capacity % 1000 || profile->full_voltage_uv > maximum_uv)
+		return -EINVAL;
+	profile->nominal_mah = get_unaligned_le16(profile->data + 412);
+	return qcom_fg4_profile_validate(profile);
+}
+
+static int fg4_probe(struct platform_device *pdev)
+{
+	static const char * const names[] = {
+		"soc-ready", "msoc-delta", "batt-missing", "batt-temp-delta", "vbatt-low",
+	};
+	struct power_supply_config config = {};
+	struct qcom_fg4_restart_ops restart = {
+		.prepare = fg4_prepare_restart,
+		.wait = fg4_wait_restart,
+	};
+	const struct qcom_spmi_pmic *pmic;
+	struct power_supply *psy;
+	struct fg4_chip *chip;
+	u32 base;
+	int ret, irq, i;
+
+	pmic = qcom_pmic_get(&pdev->dev);
+	if (IS_ERR(pmic))
+		return dev_err_probe(&pdev->dev, PTR_ERR(pmic), "could not get PMIC revision\n");
+	if (pmic->subtype != PM8150B_SUBTYPE)
+		return -ENODEV;
+	ret = device_property_read_u32(&pdev->dev, "reg", &base);
+	if (ret || base > 0xf600 || (base & 0xff))
+		return dev_err_probe(&pdev->dev, ret ?: -EINVAL, "invalid FG base address\n");
+	chip = devm_kzalloc(&pdev->dev, sizeof(*chip), GFP_KERNEL);
+	if (!chip)
+		return -ENOMEM;
+	chip->dev = &pdev->dev;
+	chip->core.base = base;
+	chip->core.major = pmic->major;
+	chip->core.map = dev_get_regmap(pdev->dev.parent, NULL);
+	if (!chip->core.map)
+		return -ENODEV;
+	mutex_init(&chip->access_lock);
+	mutex_init(&chip->core.lock);
+	init_completion(&chip->soc_ready);
+	ret = fg4_parse_profile(chip);
+	if (ret)
+		return dev_err_probe(chip->dev, ret, "invalid battery profile parameters\n");
+	ret = qcom_fg4_check_hardware(&chip->core);
+	if (ret)
+		return dev_err_probe(chip->dev, ret, "FG peripheral subtype check failed\n");
+	ret = devm_add_action_or_reset(chip->dev, fg4_cleanup, chip);
+	if (ret)
+		return ret;
+	/* Install SOC-ready before a possible profile restart. No psy is published yet. */
+	irq = platform_get_irq_byname(pdev, names[0]);
+	if (irq < 0)
+		return irq;
+	chip->irqs[0] = irq;
+	ret = devm_request_threaded_irq(chip->dev, irq, NULL, fg4_changed,
+					IRQF_ONESHOT, names[0], chip);
+	if (ret)
+		return ret;
+	restart.context = chip;
+	ret = qcom_fg4_profile_start(&chip->core, &chip->profile, &chip->profile_state, &restart);
+	if (ret)
+		return dev_err_probe(chip->dev, ret, "battery profile initialization failed\n");
+	dev_info(chip->dev, "battery ID %u ohms; profile %s\n",
+		 chip->profile_state.measured_id_ohms,
+		 chip->profile_state.loaded ? "loaded" : "identity matched");
+	chip->desc = fg4_desc;
+	config.drv_data = chip;
+	config.fwnode = dev_fwnode(chip->dev);
+	psy = devm_power_supply_register(chip->dev, &chip->desc, &config);
+	if (IS_ERR(psy))
+		return dev_err_probe(chip->dev, PTR_ERR(psy), "could not register battery\n");
+	WRITE_ONCE(chip->psy, psy);
+	ret = devm_add_action_or_reset(chip->dev, fg4_stop_notifications, chip);
+	if (ret)
+		return ret;
+	for (i = 1; i < ARRAY_SIZE(names); i++) {
+		irq = platform_get_irq_byname(pdev, names[i]);
+		if (irq < 0)
+			return irq;
+		chip->irqs[i] = irq;
+		ret = devm_request_threaded_irq(chip->dev, irq, NULL, fg4_changed,
+						IRQF_ONESHOT, names[i], chip);
+		if (ret) {
+			chip->irqs[i] = 0;
+			return ret;
+		}
+	}
+	ret = devm_device_init_wakeup(chip->dev);
+	if (ret)
+		return ret;
+	/* The final IRQ in the binding is battery voltage low. */
+	ret = devm_pm_set_wake_irq(chip->dev, irq);
+	if (ret)
+		return ret;
+	platform_set_drvdata(pdev, chip);
+	return 0;
+}
+
+static int fg4_suspend(struct device *dev)
+{
+	struct fg4_chip *chip = dev_get_drvdata(dev);
+	int ret;
+
+	mutex_lock(&chip->access_lock);
+	mutex_lock(&chip->core.lock);
+	ret = qcom_fg4_release(&chip->core);
+	mutex_unlock(&chip->core.lock);
+	if (!ret)
+		chip->suspended = true;
+	mutex_unlock(&chip->access_lock);
+	return ret;
+}
+
+static int fg4_resume(struct device *dev)
+{
+	struct fg4_chip *chip = dev_get_drvdata(dev);
+
+	mutex_lock(&chip->access_lock);
+	chip->suspended = false;
+	mutex_unlock(&chip->access_lock);
+	power_supply_changed(chip->psy);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(fg4_pm_ops, fg4_suspend, fg4_resume);
+
+static const struct of_device_id fg4_of_match[] = {
+	{ .compatible = "qcom,pm8150b-fg" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, fg4_of_match);
+
+static struct platform_driver fg4_driver = {
+	.probe = fg4_probe,
+	.driver = {
+		.name = "qcom-fg4",
+		.of_match_table = fg4_of_match,
+		.pm = pm_sleep_ptr(&fg4_pm_ops),
+	},
+};
+module_platform_driver(fg4_driver);
+
+MODULE_DESCRIPTION("Qualcomm PM8150B FG GEN4 profile and telemetry");
+MODULE_LICENSE("GPL");
