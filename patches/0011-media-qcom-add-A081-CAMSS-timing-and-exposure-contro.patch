+		       vfe->base + VFE_BUS_WM_HEADER_ADDR(wm));
+	writel_relaxed(buf->frame_header_cookie,
+		       vfe->base + VFE_BUS_WM_HEADER_CFG(wm));
+	cfg = readl_relaxed(vfe->base + VFE_BUS_WM_CFG(wm));
