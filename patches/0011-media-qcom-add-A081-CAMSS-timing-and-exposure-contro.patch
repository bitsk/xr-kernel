+	buf->frame_header = dma_alloc_coherent(vid->camss->dev,
+					     VFE_FRAME_HEADER_SIZE,
+					     &buf->frame_header_addr, GFP_KERNEL);
+	return buf->frame_header ? 0 : -ENOMEM;
