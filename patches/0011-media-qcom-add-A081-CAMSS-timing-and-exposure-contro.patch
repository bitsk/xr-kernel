+static void vfe_wm_update_header(struct vfe_device *vfe, u8 wm,
+				 struct camss_buffer *buf)
+{
+	u32 cfg;
+
+	if (!buf->frame_header)
+		return;
+
+	wm = RDI_WM(wm);
+	memset(buf->frame_header, 0, VFE_FRAME_HEADER_SIZE);
+	/* Clear recycled data before giving the paired header/image to DMA. */
+	dma_wmb();
